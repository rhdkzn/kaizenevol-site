{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(index|about|contact|services|poster|kitchen|bathroom|loft|kaizendesk|kaizenreach|kaizenforge|kitchen-jobs|bathroom-jobs|loft-jobs).html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://www.facebook.com;"
        }
      ]
    },
    {
      "source": "/(dashboard|crm|reports).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://maps.gstatic.com https://maps.googleapis.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.resend.com https://graph.facebook.com https://maps.googleapis.com https://places.googleapis.com https://cdn.jsdelivr.net;"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kaizendesk/compare",
      "destination": "/kaizendesk/compare.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/kaizenreach",
      "destination": "/kaizenreach.html"
    },
    {
      "source": "/kaizendesk",
      "destination": "/kaizendesk.html"
    },
    {
      "source": "/kaizenforge",
      "destination": "/kaizenforge.html"
    },
    {
      "source": "/kitchen-jobs",
      "destination": "/kitchen-jobs.html"
    },
    {
      "source": "/bathroom-jobs",
      "destination": "/bathroom-jobs.html"
    },
    {
      "source": "/loft-jobs",
      "destination": "/loft-jobs.html"
    },
    {
      "source": "/diagnostic",
      "destination": "/diagnostic.html"
    }
  ],
  "redirects": [
    {
      "source": "/kaizengrowth",
      "destination": "/kaizenreach.html",
      "permanent": true
    },
    {
      "source": "/kaizengrowth.html",
      "destination": "/kaizenreach.html",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/walk-reach",
      "destination": "/walk.html",
      "permanent": true
    },
    {
      "source": "/walk-reach.html",
      "destination": "/walk.html",
      "permanent": true
    },
    {
      "source": "/walk-desk",
      "destination": "/walk.html",
      "permanent": true
    },
    {
      "source": "/walk-desk.html",
      "destination": "/walk.html",
      "permanent": true
    }
  ]
}